# Required for dashboard login. Use a long, random value in production.
DASHBOARD_AUTH_SECRET=replace-with-a-long-random-secret
# The single account permitted in the Sprint 1 dashboard.
DASHBOARD_ACCESS_EMAIL=you@example.com
DASHBOARD_ACCESS_PASSWORD=replace-with-a-strong-password

# Real data sources (Sprint 2)
# Alpha Vantage News Sentiment — macro news + BTC/ETH crypto news.
# Get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=replace-with-your-alpha-vantage-key
# Forex Factory weekly economic calendar — public feed, no API key needed.
# Feed is rolling "this week" data and should be fetched at low frequency.
# https://nfs.faireconomy.media/ff_calendar_thisweek.json
# CoinDesk crypto news uses the public RSS feed — no API key needed.
